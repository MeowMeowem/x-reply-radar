# Copy to .env, or fill everything in from the Settings page.

# --- X account (cookie from your logged-in browser) ---
X_AUTH_TOKEN=
X_CT0=
# X_COOKIE=
MY_HANDLE=
DISPLAY_NAME=

# --- AI: any OpenAI-compatible API ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# AI_API_KEY_FROM=
AI_MODEL=
# AI_TIMEOUT=90

# --- Language ---
UI_LANG=auto  # auto | zh | en
CONTENT_LANG=zh  # zh | en

# --- Posting (intent = opens X with the text filled in, you press Post) ---
POST_CHANNEL=intent  # intent | browser | api
SEND_MIN_INTERVAL_SEC=90
SEND_MAX_PER_HOUR=10
SEND_MAX_PER_DAY=40
# SEND_DRY_RUN=0
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Follow-back finder (search, filter, follow) ---
FOLLOW_KEYWORDS=互关, 互粉, 互fo, 回关, 必回关, follow back, #followback, f4f
FOLLOW_MAX_RATIO=1.2
FOLLOW_MIN_FOLLOWING=20
FOLLOW_MIN_POSTS=5
FOLLOW_SEARCH_SCROLLS=3
FOLLOW_MIN_INTERVAL_SEC=90
FOLLOW_MAX_PER_HOUR=10
FOLLOW_MAX_PER_DAY=30

# --- Radar ---
AUTO_REFRESH=1
REFRESH_MIN_MINUTES=6
REFRESH_MAX_MINUTES=10
SCRAPE_TARGET=40
SHOW_TOP=10
RECHECK_TOP=8
KEEP_DAYS=10
# SCRAPE_ON_START=1
TRENDS_EVERY_MINUTES=30
WATCH_ACCOUNTS=
WATCH_EVERY_MINUTES=60

# --- Style learning ---
MINE_REFRESH_HOURS=6
MINE_SCROLLS=8
FIT_REVIEW=1
FIT_MIN_SCORE=7
CONSOLIDATE_EVERY_DAYS=7
EVAL_SAMPLES=8

# --- Daily drafts ---
DRAFT_HOUR=9
NEWS_PER_DAY=8
QUOTE_MIN_SCORE=7

# --- Server ---
PORT=8796
# OPEN_BROWSER=1
# BROWSER_CHANNEL=chrome  # chrome | chromium | msedge
# ALLOWED_HOSTS=
